# ---- staff passwords (required in production) ----
ADMIN_PASSWORD=change-me-admin
ENTRY_PASSWORD=change-me-entry
# long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# ---- Cloudflare R2 (leave empty to store data in ./.data on this machine) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kp-arena

# Public address of the bucket (custom domain), e.g. https://data.example.com
# Empty = phones read through this app's /api/public route instead.
NEXT_PUBLIC_DATA_URL=

# ---- school access code (optional) ----
# When set, visitors must type this code once, and meet.json / live.json are stored encrypted with it.
# To change it: put the old code in PREVIOUS_ACCESS_CODE, the new one in ACCESS_CODE, redeploy,
# then press 立即加密 in /admin.
ACCESS_CODE=
PREVIOUS_ACCESS_CODE=
